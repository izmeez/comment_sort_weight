<?php
/**
 * @file
 * Installation tasks for the Comment Sort Weight module.
 */

/**
 * Implements hook_schema().
 */
function comment_sort_weight_schema() {
  $schema = array();

  $schema['comment_sort_weight'] = array(
    'description' => 'Stores the precomputed display weight for each comment.',
    'fields' => array(
      'cid' => array(
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Primary Key: The {comment}.cid this weight belongs to.',
      ),
      'weight' => array(
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'The position of this comment in its node display order, computed from the flattened comment tree.',
      ),
    ),
    'primary key' => array('cid'),
    'indexes' => array(
      'comment_sort_weight_weight' => array('cid', 'weight'),
    ),
  );

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function comment_sort_weight_uninstall() {
  config_clear('comment_sort_weight.settings', 'types');
}
